\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces HybridMTLNet architecture (channels~$\times $~spatial dimensions are indicated per block). A shared ResNet-34 encoder extracts multi-scale features $x_0$--$x_4$. The bottleneck representation $x_4$ feeds two parallel branches: a U-Net-based segmentation decoder ($d_4$--$d_1$, with dotted lines denoting skip connections from the encoder) yielding two dense instance masks, and a deconvolutional pose head ($p_1$--$p_3$) yielding six keypoint heatmaps ($3$ keypoints $\times \,2$ instances). Both outputs are restored to the original $256{\times }256$ resolution.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:arch}{{1}{4}{HybridMTLNet architecture (channels~$\times $~spatial dimensions are indicated per block). A shared ResNet-34 encoder extracts multi-scale features $x_0$--$x_4$. The bottleneck representation $x_4$ feeds two parallel branches: a U-Net-based segmentation decoder ($d_4$--$d_1$, with dotted lines denoting skip connections from the encoder) yielding two dense instance masks, and a deconvolutional pose head ($p_1$--$p_3$) yielding six keypoint heatmaps ($3$ keypoints $\times \,2$ instances). Both outputs are restored to the original $256{\times }256$ resolution}{figure.1}{}}
