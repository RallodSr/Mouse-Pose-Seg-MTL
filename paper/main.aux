\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Loss-weight ratio (seg:pose) on the joint model; test-set scores for a single representative run (Fig.~\ref {fig:training} tracks validation). mIoU stays stable while PCK rises with the pose weight then saturates; we adopt 1:500, whose 3-seed mean is reported in Table~\ref {tab:results}.}}{10}{table.2}\protected@file@percent }
\newlabel{tab:weights}{{2}{10}{Loss-weight ratio (seg:pose) on the joint model; test-set scores for a single representative run (Fig.~\ref {fig:training} tracks validation). mIoU stays stable while PCK rises with the pose weight then saturates; we adopt 1:500, whose 3-seed mean is reported in Table~\ref {tab:results}}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Single-task ablation and a cross-task variant on the same network (mean~$\pm $~standard deviation over three seeds). Joint training preserves segmentation but loses a little pose accuracy; bidirectional cross-task guidance recovers part of the pose gap without closing it.}}{10}{table.3}\protected@file@percent }
\newlabel{tab:ablation}{{3}{10}{Single-task ablation and a cross-task variant on the same network (mean~$\pm $~standard deviation over three seeds). Joint training preserves segmentation but loses a little pose accuracy; bidirectional cross-task guidance recovers part of the pose gap without closing it}{table.3}{}}
